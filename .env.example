# --- Base de datos (Docker Compose) ---------------------------------------
POSTGRES_DB=taller_db
POSTGRES_USER=taller_user
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_PORT=5432

# Host "db" dentro de Docker Compose; usa "localhost" si ejecutas la API
# directamente en la máquina.
DATABASE_URL=postgresql+asyncpg://taller_user:cambia-esta-clave-local@db:5432/taller_db

# --- Seguridad ------------------------------------------------------------
# Genera una clave real antes de arrancar; la aplicación rechaza las claves
# de ejemplo para no desplegar nunca con una clave pública:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=genera-una-clave-aleatoria-con-secrets-token-urlsafe-48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- API ------------------------------------------------------------------
# desarrollo | produccion | pruebas
# En "produccion" la documentación interactiva (/docs) queda deshabilitada.
APP_ENV=desarrollo

# Orígenes permitidos del frontend, separados por comas. No se admite "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# IP (o CIDR) de los proxies de confianza. Solo si la API corre detrás de un
# proxy (Railway, Nginx, un balanceador) conviene declararlo: es lo que
# permite leer la IP real del cliente para el límite de intentos.
TRUSTED_PROXY_IPS=
