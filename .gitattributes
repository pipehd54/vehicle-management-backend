# Normaliza los finales de linea en el repositorio: LF en el repositorio,
# LF en Linux/macOS y el final de linea nativo en Windows.
* text=auto eol=lf

# Archivos que deben conservar CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios que no deben tocarse
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite3 binary
